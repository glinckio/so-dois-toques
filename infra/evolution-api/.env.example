# Copie para .env e ajuste. Nunca versione o .env.
# Chave do servidor Evolution: use o mesmo valor em EVOLUTION_API_KEY no services/evolution/.env.
AUTHENTICATION_API_KEY=troque-por-uma-chave-aleatoria
# Senha do PostgreSQL do Evolution (só na rede interna do compose).
POSTGRES_PASSWORD=troque-por-uma-senha-forte

# Porta no computador (127.0.0.1). Troque se a 8080 já estiver em uso; ajuste SERVER_URL e
# o EVOLUTION_API_URL do microserviço junto.
EVOLUTION_PORTA=8080

SERVER_TYPE=http
SERVER_PORT=8080
SERVER_URL=http://localhost:8080

DATABASE_ENABLED=true
DATABASE_PROVIDER=postgresql
# Mesma senha de POSTGRES_PASSWORD.
DATABASE_CONNECTION_URI=postgresql://evolution:troque-por-uma-senha-forte@evolution-postgres:5432/evolution?schema=public
DATABASE_CONNECTION_CLIENT_NAME=sdt_evolution
DATABASE_SAVE_DATA_INSTANCE=true
DATABASE_SAVE_DATA_NEW_MESSAGE=true
DATABASE_SAVE_MESSAGE_UPDATE=true
DATABASE_SAVE_DATA_CONTACTS=true
DATABASE_SAVE_DATA_CHATS=true
DATABASE_SAVE_DATA_HISTORIC=true

CACHE_REDIS_ENABLED=true
CACHE_REDIS_URI=redis://evolution-redis:6379/0
CACHE_REDIS_PREFIX_KEY=sdt_evolution
CACHE_LOCAL_ENABLED=false

DEL_INSTANCE=false
TELEMETRY_ENABLED=false
LOG_LEVEL=ERROR,WARN,INFO
LOG_BAILEYS=error

# Nome que aparece em "Aparelhos conectados" no celular da escola.
CONFIG_SESSION_PHONE_CLIENT=Só Dois Toques
CONFIG_SESSION_PHONE_NAME=Chrome
CONFIG_SESSION_PHONE_VERSION=2.3000.1030831524
QRCODE_LIMIT=30
QRCODE_COLOR=#7c3aed
