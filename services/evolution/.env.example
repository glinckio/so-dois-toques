# Copie para .env e ajuste. Nunca versione o .env.
# Porta do microserviço.
PORT=3004

# Chave que a API do sistema manda no cabeçalho x-internal-api-key. Mínimo 32 caracteres.
# Use o mesmo valor em EVOLUTION_CHAVE no apps/api/.env.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
INTERNAL_API_KEY="troque-por-uma-chave-aleatoria-de-32-caracteres-ou-mais"

# Servidor Evolution API (infra/evolution-api). EVOLUTION_API_KEY = AUTHENTICATION_API_KEY de lá.
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY="troque-pela-authentication-api-key-do-evolution"

# Endereço deste microserviço visto pelo servidor Evolution (para o webhook).
# Evolution no Docker e este serviço no computador: http://host.docker.internal:3004
API_PUBLIC_URL=http://host.docker.internal:3004

# Token que o Evolution manda no webhook (?token=...). Mínimo 32 caracteres.
WEBHOOK_TOKEN="troque-por-outro-token-aleatorio-de-32-caracteres-ou-mais"
