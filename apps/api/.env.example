# Copie para .env e ajuste. Nunca versione o .env.
# Valores abaixo correspondem ao docker-compose.yml (apenas desenvolvimento local).
DATABASE_URL="postgresql://sdt:sdt_local_dev@localhost:5432/so_dois_toques"
PORT=3001
WEB_ORIGIN="http://localhost:3000"
# Chave compartilhada entre o web (servidor) e a API. Mínimo 32 caracteres.
# Gere uma nova com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
INTERNAL_API_KEY="troque-por-uma-chave-aleatoria-de-32-caracteres-ou-mais"
# Gera as mensalidades do mês sozinha, na subida da API e a cada hora (true ou false).
GERACAO_AUTOMATICA=true
# Etapa 20: Chat do WhatsApp. Endereço do microserviço (services/evolution) e a mesma chave
# do INTERNAL_API_KEY dele. Deixe as duas vazias para o sistema funcionar sem o Chat.
EVOLUTION_URL=
EVOLUTION_CHAVE=
EVOLUTION_INSTANCIA=so-dois-toques
