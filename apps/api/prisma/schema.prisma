// Schema do banco. Os modelos de negócio entram a partir da Etapa 1,
// cada um definido na spec da sua etapa.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

/// Etapa 16: o perfil Professor saiu; quem era professor virou atendente.
enum Perfil {
  ADMINISTRADOR
  ATENDENTE
}

model Usuario {
  id           String   @id @default(uuid()) @db.Uuid
  nome         String   @db.VarChar(120)
  email        String   @unique @db.VarChar(254)
  perfil       Perfil
  ativo        Boolean  @default(true)
  senhaHash    String
  trocarSenha  Boolean  @default(true)
  criadoEm     DateTime @default(now()) @db.Timestamptz(3)
  atualizadoEm DateTime @updatedAt @db.Timestamptz(3)

  sessoes                Sessao[]
  consentimentos         Aluno[]           @relation("ConsentimentoRegistradoPor")
  presencasRegistradas   Presenca[]
  assinaturasCriadas     Assinatura[]
  mensalidadesCanceladas Mensalidade[]
  pagamentosRecebidos    Pagamento[]       @relation("PagamentoRecebidoPor")
  pagamentosEstornados   Pagamento[]       @relation("PagamentoEstornadoPor")
  lancamentos            Lancamento[]
  bloqueiosCriados       Bloqueio[]        @relation("BloqueioCriadoPor")
  bloqueiosCancelados    Bloqueio[]        @relation("BloqueioCanceladoPor")
  seriesCriadas          SerieBloqueio[]   @relation("SerieCriadaPor")
  seriesEncerradas       SerieBloqueio[]   @relation("SerieEncerradaPor")
  contratosCriados       ContratoQuadra[]  @relation("ContratoCriadoPor")
  contratosEncerrados    ContratoQuadra[]  @relation("ContratoEncerradoPor")
  mensagensEnviadas      MensagemEnviada[]

  @@index([perfil, ativo])
}

model Sessao {
  id          String   @id @default(uuid()) @db.Uuid
  tokenHash   String   @unique @db.Char(64)
  usuarioId   String   @db.Uuid
  usuario     Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  criadaEm    DateTime @default(now()) @db.Timestamptz(3)
  ultimoUsoEm DateTime @default(now()) @db.Timestamptz(3)
  expiraEm    DateTime @db.Timestamptz(3)
  ip          String?  @db.VarChar(64)
  agente      String?  @db.VarChar(300)

  @@index([usuarioId])
}

model TentativaLogin {
  id       BigInt   @id @default(autoincrement())
  email    String   @db.VarChar(254)
  ip       String?  @db.VarChar(64)
  sucesso  Boolean
  criadaEm DateTime @default(now()) @db.Timestamptz(3)

  @@index([email, criadaEm])
  @@index([ip, criadaEm])
}

/// Registro imutável: um gatilho no banco recusa UPDATE, DELETE e TRUNCATE.
model Auditoria {
  id       BigInt   @id @default(autoincrement())
  criadaEm DateTime @default(now()) @db.Timestamptz(3)
  atorId   String?  @db.Uuid
  acao     String   @db.VarChar(40)
  alvoTipo String?  @db.VarChar(40)
  alvoId   String?  @db.VarChar(64)
  ip       String?  @db.VarChar(64)
  detalhes Json?

  @@index([criadaEm])
  @@index([atorId, criadaEm])
  @@index([acao, criadaEm])
}

// Etapa 2: Aulas (alunos, turmas, matrículas e presença). Etapa 14: toda turma é na quadra.

enum Nivel {
  INICIANTE
  INTERMEDIARIO
  AVANCADO
}

enum CategoriaTurma {
  MASCULINO
  MISTO
  FEMININO
}

enum Consentidor {
  ALUNO
  RESPONSAVEL
}

model Aluno {
  id                           String      @id @default(uuid()) @db.Uuid
  nome                         String      @db.VarChar(120)
  /// Nome sem acento e em minúsculas, para a busca.
  nomeBusca                    String      @db.VarChar(120)
  /// Só dígitos, com DDD. Vazio depois da anonimização.
  telefone                     String      @db.VarChar(11)
  nascimento                   DateTime?   @db.Date
  email                        String?     @db.VarChar(254)
  observacoes                  String?     @db.VarChar(500)
  emergenciaNome               String?     @db.VarChar(120)
  emergenciaTelefone           String?     @db.VarChar(11)
  responsavelNome              String?     @db.VarChar(120)
  responsavelTelefone          String?     @db.VarChar(11)
  consentimentoEm              DateTime    @db.Timestamptz(3)
  consentimentoPor             Consentidor
  consentimentoRegistradoPorId String      @db.Uuid
  consentimentoRegistradoPor   Usuario     @relation("ConsentimentoRegistradoPor", fields: [consentimentoRegistradoPorId], references: [id], onDelete: Restrict)
  ativo                        Boolean     @default(true)
  anonimizadoEm                DateTime?   @db.Timestamptz(3)
  criadoEm                     DateTime    @default(now()) @db.Timestamptz(3)
  atualizadoEm                 DateTime    @updatedAt @db.Timestamptz(3)

  matriculas   Matricula[]
  presencas    Presenca[]
  assinaturas  Assinatura[]
  mensalidades Mensalidade[]

  @@index([nomeBusca])
  @@index([telefone])
}

/// Etapa 16: a turma é um horário fixo da semana (dia, início e fim), com nível e vagas.
model Turma {
  id           String         @id @default(uuid()) @db.Uuid
  /// Etapa 17: a quadra onde a turma acontece.
  quadraId     String         @db.Uuid
  quadra       Quadra         @relation(fields: [quadraId], references: [id], onDelete: Restrict)
  /// 0 = domingo ... 6 = sábado
  diaSemana    Int            @db.SmallInt
  /// Minutos desde 00:00, das 05:00 às 23:59.
  horaInicio   Int            @db.SmallInt
  horaFim      Int            @db.SmallInt
  nivel        Nivel
  /// Etapa 16: quem a turma recebe.
  categoria    CategoriaTurma @default(MISTO)
  vagas        Int
  ativa        Boolean        @default(true)
  /// Data (São Paulo) em que a turma passou a existir; presença só a partir dela.
  inicio       DateTime       @db.Date
  encerradaEm  DateTime?      @db.Timestamptz(3)
  criadaEm     DateTime       @default(now()) @db.Timestamptz(3)
  atualizadaEm DateTime       @updatedAt @db.Timestamptz(3)

  matriculas Matricula[]
  presencas  Presenca[]
  feedbacks  RespostaFeedback[]

  @@index([quadraId, diaSemana, ativa])
}

model Matricula {
  id       String    @id @default(uuid()) @db.Uuid
  alunoId  String    @db.Uuid
  aluno    Aluno     @relation(fields: [alunoId], references: [id], onDelete: Restrict)
  turmaId  String    @db.Uuid
  turma    Turma     @relation(fields: [turmaId], references: [id], onDelete: Restrict)
  inicio   DateTime  @db.Date
  fim      DateTime? @db.Date
  criadaEm DateTime  @default(now()) @db.Timestamptz(3)

  @@index([turmaId, fim])
  @@index([alunoId, fim])
}

model Presenca {
  id              String   @id @default(uuid()) @db.Uuid
  turmaId         String   @db.Uuid
  turma           Turma    @relation(fields: [turmaId], references: [id], onDelete: Restrict)
  alunoId         String   @db.Uuid
  aluno           Aluno    @relation(fields: [alunoId], references: [id], onDelete: Restrict)
  data            DateTime @db.Date
  presente        Boolean
  registradaPorId String   @db.Uuid
  registradaPor   Usuario  @relation(fields: [registradaPorId], references: [id], onDelete: Restrict)
  registradaEm    DateTime @default(now()) @db.Timestamptz(3)

  @@unique([turmaId, alunoId, data])
  @@index([alunoId])
}

// Etapa 3: Mensalidades e livro-razão

enum SituacaoMensalidade {
  ABERTA
  PAGA
  CANCELADA
}

enum FormaPagamento {
  PIX
  DINHEIRO
  CARTAO_DEBITO
  CARTAO_CREDITO
}

enum TipoLancamento {
  ENTRADA
  SAIDA
}

enum CategoriaLancamento {
  MENSALIDADE
  ESTORNO
  /// Etapa 17
  SALDO_INICIAL
  ALUGUEL_MENSAL
  LOCACAO_AVULSA
  EQUIPAMENTO
  INVESTIMENTO
  OUTRO_GASTO
}

model Plano {
  id             String   @id @default(uuid()) @db.Uuid
  nome           String   @unique @db.VarChar(60)
  aulasPorSemana Int      @db.SmallInt
  valorCentavos  Int
  ativo          Boolean  @default(true)
  criadoEm       DateTime @default(now()) @db.Timestamptz(3)
  atualizadoEm   DateTime @updatedAt @db.Timestamptz(3)

  assinaturas Assinatura[]
}

/// O plano de um aluno a partir de um mês. Trocar o plano encerra esta e abre outra.
model Assinatura {
  id               String    @id @default(uuid()) @db.Uuid
  alunoId          String    @db.Uuid
  aluno            Aluno     @relation(fields: [alunoId], references: [id], onDelete: Restrict)
  planoId          String    @db.Uuid
  plano            Plano     @relation(fields: [planoId], references: [id], onDelete: Restrict)
  diaVencimento    Int       @db.SmallInt
  descontoCentavos Int       @default(0)
  motivoDesconto   String?   @db.VarChar(200)
  /// Primeiro dia do primeiro mês cobrado.
  inicio           DateTime  @db.Date
  /// Primeiro dia do primeiro mês que não é mais cobrado.
  fim              DateTime? @db.Date
  criadaPorId      String    @db.Uuid
  criadaPor        Usuario   @relation(fields: [criadaPorId], references: [id], onDelete: Restrict)
  criadaEm         DateTime  @default(now()) @db.Timestamptz(3)

  mensalidades Mensalidade[]

  @@index([alunoId, fim])
}

model Mensalidade {
  id                 String              @id @default(uuid()) @db.Uuid
  alunoId            String              @db.Uuid
  aluno              Aluno               @relation(fields: [alunoId], references: [id], onDelete: Restrict)
  assinaturaId       String              @db.Uuid
  assinatura         Assinatura          @relation(fields: [assinaturaId], references: [id], onDelete: Restrict)
  /// Primeiro dia do mês da mensalidade.
  competencia        DateTime            @db.Date
  /// Valor congelado na geração (plano menos desconto).
  valorCentavos      Int
  vencimento         DateTime            @db.Date
  situacao           SituacaoMensalidade @default(ABERTA)
  canceladaEm        DateTime?           @db.Timestamptz(3)
  canceladaPorId     String?             @db.Uuid
  canceladaPor       Usuario?            @relation(fields: [canceladaPorId], references: [id], onDelete: Restrict)
  motivoCancelamento String?             @db.VarChar(200)
  criadaEm           DateTime            @default(now()) @db.Timestamptz(3)

  pagamentos Pagamento[]

  @@unique([alunoId, competencia])
  @@index([competencia, situacao])
  @@index([situacao, vencimento])
}

model Pagamento {
  id                  String         @id @default(uuid()) @db.Uuid
  numeroRecibo        Int            @unique @default(autoincrement())
  mensalidadeId       String         @db.Uuid
  mensalidade         Mensalidade    @relation(fields: [mensalidadeId], references: [id], onDelete: Restrict)
  valorCentavos       Int
  forma               FormaPagamento
  data                DateTime       @db.Date
  recebidoPorId       String         @db.Uuid
  recebidoPor         Usuario        @relation("PagamentoRecebidoPor", fields: [recebidoPorId], references: [id], onDelete: Restrict)
  recebidoEm          DateTime       @default(now()) @db.Timestamptz(3)
  lancamentoId        String         @unique @db.Uuid
  lancamento          Lancamento     @relation("LancamentoDoPagamento", fields: [lancamentoId], references: [id], onDelete: Restrict)
  estornadoEm         DateTime?      @db.Timestamptz(3)
  estornadoPorId      String?        @db.Uuid
  estornadoPor        Usuario?       @relation("PagamentoEstornadoPor", fields: [estornadoPorId], references: [id], onDelete: Restrict)
  motivoEstorno       String?        @db.VarChar(200)
  estornoLancamentoId String?        @unique @db.Uuid
  estornoLancamento   Lancamento?    @relation("EstornoDoPagamento", fields: [estornoLancamentoId], references: [id], onDelete: Restrict)

  @@index([mensalidadeId])
}

/// Livro-razão das mensalidades. Imutável: um gatilho no banco recusa UPDATE, DELETE e TRUNCATE.
model Lancamento {
  id            String              @id @default(uuid()) @db.Uuid
  tipo          TipoLancamento
  valorCentavos Int
  forma         FormaPagamento
  /// Data (São Paulo) em que o dinheiro entrou ou saiu.
  data          DateTime            @db.Date
  categoria     CategoriaLancamento
  descricao     String              @db.VarChar(200)
  origemTipo    String?             @db.VarChar(40)
  origemId      String?             @db.VarChar(64)
  estornoDeId   String?             @unique @db.Uuid
  estornoDe     Lancamento?         @relation("Estorno", fields: [estornoDeId], references: [id], onDelete: Restrict)
  estorno       Lancamento?         @relation("Estorno")
  criadoPorId   String              @db.Uuid
  criadoPor     Usuario             @relation(fields: [criadoPorId], references: [id], onDelete: Restrict)
  criadoEm      DateTime            @default(now()) @db.Timestamptz(3)

  pagamento        Pagamento? @relation("LancamentoDoPagamento")
  estornoPagamento Pagamento? @relation("EstornoDoPagamento")

  @@index([data])
}

// Etapa 7 e 14: agenda da quadra

/// A quadra do local. Uma só, criada na migração.
/// Etapa 17: as quadras alugadas onde as turmas acontecem.
model Quadra {
  id       String   @id @default(uuid()) @db.Uuid
  nome     String   @unique @db.VarChar(40)
  ativa    Boolean  @default(true)
  criadaEm DateTime @default(now()) @db.Timestamptz(3)

  turmas    Turma[]
  bloqueios Bloqueio[]
  series    SerieBloqueio[]
  contratos ContratoQuadra[]
}

/// Etapa 17: aluguel mensal fixo de um horário da semana numa quadra.
model ContratoQuadra {
  id             String         @id @default(uuid()) @db.Uuid
  quadraId       String         @db.Uuid
  quadra         Quadra         @relation(fields: [quadraId], references: [id], onDelete: Restrict)
  /// 0 = domingo ... 6 = sábado
  diaSemana      Int            @db.SmallInt
  /// Minutos desde 00:00.
  horaInicio     Int            @db.SmallInt
  horaFim        Int            @db.SmallInt
  valorCentavos  Int
  /// Dia do mês em que o aluguel é lançado (1 a 28).
  diaPagamento   Int            @db.SmallInt
  forma          FormaPagamento
  /// Primeiro dia do primeiro mês pago.
  inicio         DateTime       @db.Date
  /// Primeiro dia do primeiro mês que não é mais pago.
  fim            DateTime?      @db.Date
  criadoPorId    String         @db.Uuid
  criadoPor      Usuario        @relation("ContratoCriadoPor", fields: [criadoPorId], references: [id], onDelete: Restrict)
  criadoEm       DateTime       @default(now()) @db.Timestamptz(3)
  encerradoPorId String?        @db.Uuid
  encerradoPor   Usuario?       @relation("ContratoEncerradoPor", fields: [encerradoPorId], references: [id], onDelete: Restrict)
  encerradoEm    DateTime?      @db.Timestamptz(3)

  @@index([fim])
}

/// Bloqueio semanal. Gera os bloqueios de uma vez.
model SerieBloqueio {
  id             String    @id @default(uuid()) @db.Uuid
  quadraId       String    @db.Uuid
  quadra         Quadra    @relation(fields: [quadraId], references: [id], onDelete: Restrict)
  /// 0 = domingo ... 6 = sábado
  diaSemana      Int       @db.SmallInt
  horaInicio     Int       @db.SmallInt
  horaFim        Int       @db.SmallInt
  motivo         String    @db.VarChar(200)
  dataInicio     DateTime  @db.Date
  dataFim        DateTime  @db.Date
  criadaPorId    String    @db.Uuid
  criadaPor      Usuario   @relation("SerieCriadaPor", fields: [criadaPorId], references: [id], onDelete: Restrict)
  criadaEm       DateTime  @default(now()) @db.Timestamptz(3)
  encerradaEm    DateTime? @db.Timestamptz(3)
  encerradaPorId String?   @db.Uuid
  encerradaPor   Usuario?  @relation("SerieEncerradaPor", fields: [encerradaPorId], references: [id], onDelete: Restrict)

  bloqueios Bloqueio[]

  @@index([encerradaEm])
}

/// Horário da quadra fechado (manutenção, evento). Dois não cancelados nunca se
/// sobrepõem na mesma data (restrição de exclusão na migração).
model Bloqueio {
  id                 String         @id @default(uuid()) @db.Uuid
  quadraId           String         @db.Uuid
  quadra             Quadra         @relation(fields: [quadraId], references: [id], onDelete: Restrict)
  data               DateTime       @db.Date
  /// Horas inteiras: início de 5 a 23, fim de 6 a 24.
  horaInicio         Int            @db.SmallInt
  horaFim            Int            @db.SmallInt
  motivo             String         @db.VarChar(200)
  serieId            String?        @db.Uuid
  serie              SerieBloqueio? @relation(fields: [serieId], references: [id], onDelete: Restrict)
  criadoPorId        String         @db.Uuid
  criadoPor          Usuario        @relation("BloqueioCriadoPor", fields: [criadoPorId], references: [id], onDelete: Restrict)
  criadoEm           DateTime       @default(now()) @db.Timestamptz(3)
  canceladoEm        DateTime?      @db.Timestamptz(3)
  canceladoPorId     String?        @db.Uuid
  canceladoPor       Usuario?       @relation("BloqueioCanceladoPor", fields: [canceladoPorId], references: [id], onDelete: Restrict)
  motivoCancelamento String?        @db.VarChar(200)

  @@index([quadraId, data])
  @@index([serieId])
}

// Etapa 19: feedback dos alunos (formulário público, sem login)

/// Resposta do formulário público. Pode ser removida (spam ou ofensa); não guarda o IP.
model RespostaFeedback {
  id         String    @id @default(uuid()) @db.Uuid
  /// De 1 a 5.
  nota       Int       @db.SmallInt
  comentario String?   @db.VarChar(1000)
  melhoria   String?   @db.VarChar(1000)
  turmaId    String?   @db.Uuid
  turma      Turma?    @relation(fields: [turmaId], references: [id], onDelete: SetNull)
  /// Vazio = anônimo.
  nome       String?   @db.VarChar(120)
  lidaEm     DateTime? @db.Timestamptz(3)
  criadaEm   DateTime  @default(now()) @db.Timestamptz(3)

  @@index([criadaEm])
  @@index([lidaEm])
}

/// Só para o limite de envios por hora: o hash do IP, sem ligação com a resposta.
model EnvioFeedback {
  id       BigInt   @id @default(autoincrement())
  ipHash   String   @db.Char(64)
  criadoEm DateTime @default(now()) @db.Timestamptz(3)

  @@index([ipHash, criadoEm])
}

/// Uma linha só (id = 1): o formulário está pausado ou não.
model FormularioFeedback {
  id         Int      @id @default(1)
  pausado    Boolean  @default(false)
  alteradoEm DateTime @default(now()) @updatedAt @db.Timestamptz(3)
}

// Etapa 20: chat do WhatsApp. As conversas ficam no Evolution; aqui só quem da equipe enviou.

/// Mensagem enviada pelo sistema: o identificador dela no WhatsApp e quem enviou (CHAT-CA-09).
model MensagemEnviada {
  /// Identificador da mensagem no WhatsApp (key.id).
  id        String   @id @db.VarChar(64)
  /// Número da conversa, só dígitos com DDI.
  numero    String   @db.VarChar(20)
  usuarioId String   @db.Uuid
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  enviadaEm DateTime @default(now()) @db.Timestamptz(3)

  @@index([numero, enviadaEm])
}
