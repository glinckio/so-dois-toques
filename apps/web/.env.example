# Copie para .env.local e ajuste. Nunca versione o .env.local.
# Endereço da API NestJS (o navegador nunca fala com ela; só o servidor do Next.js).
API_URL="http://localhost:3001"
# A mesma INTERNAL_API_KEY configurada em apps/api/.env.
INTERNAL_API_KEY="troque-por-uma-chave-aleatoria-de-32-caracteres-ou-mais"
# Quantos proxies da hospedagem ficam na frente do web, para achar o IP real do
# visitante no X-Forwarded-For (1 na Vercel, no Render e no Railway).
IP_SALTOS_CONFIAVEIS=1
